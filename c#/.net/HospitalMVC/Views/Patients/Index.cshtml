@model List<HospitalMVC.Models.Patient>

<h2>Patients List</h2>

<table border="1" cellpadding="10">

<tr>
    <th>Id</th>
    <th>Name</th>
    <th>Age</th>
    <th>Gender</th>
    <th>Phone</th>
    <th>Address</th>
</tr>

@foreach(var patient in Model)
{
<tr>
    <td>@patient.Id</td>
    <td>@patient.Name</td>
    <td>@patient.Age</td>
    <td>@patient.Gender</td>
    <td>@patient.Phone</td>
    <td>@patient.Address</td>
</tr>
}

</table>